# Backend
DATABASE_URL=postgresql+psycopg2://devsecagent:devsecagent@localhost:5432/devsecagent
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173

# AI
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini

# GitHub (for private repos - Phase 2)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=

# Scanners (system must have these installed)
# Semgrep, Bandit, Gitleaks will be called via subprocess
SCAN_WORKSPACE_ROOT=/tmp/devsecagent_scans
SCAN_TIMEOUT_SECONDS=300
